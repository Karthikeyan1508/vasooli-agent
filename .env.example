# Environment variable template for Vasooli Agent.
# Database
DATABASE_URL=postgresql://user:pass@host:5432/vasooli

# Backend
PORT=10000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:10000

# Business logic
RBI_BANK_RATE=6.5

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_INTAKE_AGENT_ID=
ELEVENLABS_OUTBOUND_AGENT_ID=
# Twilio phone number registered to the outbound agent (agent_phone_number_id in the outbound-call API)
ELEVENLABS_OUTBOUND_PHONE_NUMBER_ID=

# The Breeth
BREETH_API_KEY=
BREETH_MCP_URL=https://mcp.thebreeth.com/mcp

# Dodo Payments
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
# Optional override; defaults to test.dodopayments.com, or live.dodopayments.com when NODE_ENV=production
DODO_API_BASE_URL=

# n8n (also set these as environment variables on the n8n instance itself, not just here)
N8N_WEBHOOK_URL=
N8N_API_KEY=
BACKEND_API_URL=http://localhost:10000

# Production integrations (set these in the relevant hosted service, not in Git)
# FRONTEND_URL=https://vasooli-frontend-oizq.onrender.com
# NEXT_PUBLIC_API_URL=https://vasooli-backend-eqq2.onrender.com
# BACKEND_API_URL=https://vasooli-backend-eqq2.onrender.com
