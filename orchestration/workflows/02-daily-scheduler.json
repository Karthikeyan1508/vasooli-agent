{"_comment":"Runs daily to advance the legal clock on unpaid invoices and hand each one to the escalation ladder. Payment confirmation is not polled here: Dodo pushes /api/webhooks/dodo directly on success, which is the source of truth for the paid status.","name":"Vasooli 02 - Daily Scheduler","nodes":[{"name":"Workflow note","type":"n8n-nodes-base.stickyNote","parameters":{"content":"Daily: list unpaid invoices, add a day, let the backend derive the escalation status, then trigger workflow 03 per invoice."}},{"name":"Daily Trigger","type":"n8n-nodes-base.cron","parameters":{"triggerTimes":{"item":[{"mode":"everyDay","hour":9}]}}},{"name":"List Invoices","type":"n8n-nodes-base.httpRequest","parameters":{"url":"={{$env.BACKEND_API_URL}}/api/invoices?status=active","method":"GET","authentication":"predefinedCredentialType","nodeCredentialType":"httpHeaderAuth"},"credentials":{"httpHeaderAuth":{"name":"Vasooli Backend API"}}},{"name":"Evaluate Clock","type":"n8n-nodes-base.httpRequest","parameters":{"url":"={{$env.BACKEND_API_URL}}/api/invoices/{{$json.invoice_id}}/increment-days","method":"POST","authentication":"predefinedCredentialType","nodeCredentialType":"httpHeaderAuth","sendBody":true,"specifyBody":"json","jsonBody":"={{ { days: 1 } }}"},"credentials":{"httpHeaderAuth":{"name":"Vasooli Backend API"}}},{"name":"Trigger Escalation","type":"n8n-nodes-base.httpRequest","parameters":{"url":"={{$env.N8N_WEBHOOK_URL}}/webhook/vasooli/escalate","method":"POST","sendBody":true,"specifyBody":"json","jsonBody":"={{ $json }}"}}],"connections":{"Daily Trigger":{"main":[[{"node":"List Invoices","type":"main","index":0}]]},"List Invoices":{"main":[[{"node":"Evaluate Clock","type":"main","index":0}]]},"Evaluate Clock":{"main":[[{"node":"Trigger Escalation","type":"main","index":0}]]}}}
